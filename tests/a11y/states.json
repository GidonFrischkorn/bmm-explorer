{
 "//": "One entry per rendered page; every page is checked in its default state plus the states listed here. A step is { click: selector } | { note: info id } | { range: [selector, value] } | { number: [selector, value] } | { select: [selector, value] }. A state's optional expect lists what must hold after its steps: a selector that must match, or [selector, property, value] ('visible': takes up space; 'text': its text contains the value). An out-of-range state expects .ex-dash.ex-stale, and the run then checks that the stale notice was announced. A page's optional focus: { walk: Tab through the dashboard, marks: draggable svg items whose focus mark is checked }. A new page needs an entry (run-axe.mjs fails without one).",
 "viewport": [
  1280,
  800
 ],
 "tablet": {
  "//": "A second pass at tablet size with touch: these states of every page that has them.",
  "viewport": [
   1024,
   768
  ],
  "states": [
   "default",
   "simulate on"
  ]
 },
 "map": {
  "//": "The landing page model map: cards in the laptop and tablet passes, a plain list at this narrow size.",
  "page": "index",
  "narrow": [
   760,
   1000
  ]
 },
