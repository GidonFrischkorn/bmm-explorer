  "index": {},
  "about": {},
  "models/m3": {
   "states": [
    {
     "name": "simulate on",
     "steps": [
      {
       "click": "#m3-sim"
      }
     ],
     "expect": [
      [
       "#m3-sim",
       "checked",
       true
      ],
      [
       "#m3-sim-text",
       "hidden",
       false
      ]
