       "hidden",
       false
      ]
     ]
    },
    {
     "name": "complex span",
     "steps": [
      {
       "click": "input[name=\"m3-version\"][value=\"cs\"]"
      }
     ],
     "expect": [
      [
       "input[name=\"m3-version\"][value=\"cs\"]",
       "checked",
       true
      ],
      [
       "#m3-f",
       "visible",
       true
      ],
      [
       "#m3-code",
       "text",
       "version = \"cs\""
      ]
     ]
    },
    {
     "name": "complex span, simulate on, note open: f",
     "steps": [
      {
       "click": "input[name=\"m3-version\"][value=\"cs\"]"
      },
      {
       "click": "#m3-sim"
      },
      {
       "note": "m3-f-info"
      }
     ],
     "expect": [
      [
       "input[name=\"m3-version\"][value=\"cs\"]",
       "checked",
       true
      ],
      [
       "#m3-sim",
       "checked",
       true
      ],
      [
       "#m3-sim-text",
       "hidden",
       false
      ],
      [
       "#m3-f-info",
       "hidden",
       false
      ],
      [
       "#m3-f",
       "visible",
       true
      ],
      [
       "#m3-code",
       "text",
       "version = \"cs\""
      ]
     ]
    },
    {
     "name": "c raised",
     "steps": [
      {
       "range": [
        "#m3-c",
        "3.5"
       ]
      }
     ],
     "expect": [
      [
       "#m3-c",
       "value",
       "3.5"
      ],
      [
       "#m3-c-num",
       "value",
       "33.1"
      ],
      [
       "#m3-bars > desc",
       "text",
       "correct 0.87,"
      ]
     ]
    },
    {
     "name": "softmax",
     "steps": [
      {
       "click": "input[name=\"m3-rule\"][value=\"softmax\"]"
      }
     ],
     "expect": [
      [
       "input[name=\"m3-rule\"][value=\"softmax\"]",
       "checked",
       true
      ],
      [
       "#m3-code",
       "text",
       "choice_rule = \"softmax\""
      ]
     ]
    },
    {
     "name": "gaussian, simulate on",
     "steps": [
      {
       "click": "input[name=\"m3-rule\"][value=\"gaussian\"]"
      },
      {
       "click": "#m3-sim"
      }
     ],
     "expect": [
      [
       "input[name=\"m3-rule\"][value=\"gaussian\"]",
       "checked",
       true
      ],
      [
       "#m3-sim",
       "checked",
       true
      ],
      [
       "#m3-sim-text",
       "hidden",
       false
      ],
      [
       "#m3-code",
       "text",
       "choice_rule = \"gaussian\""
      ]
     ]
    },
    {
     "name": "out of range: a negative under the simple rule",
     "steps": [
      {
       "number": [
        "#m3-a-num",
        "-5"
       ]
      }
     ],
     "expect": [
      "#m3-a-num.ex-invalid",
      ".ex-dash.ex-stale"
     ]
    },
    {
     "name": "out of range: set size 99",
     "steps": [
      {
       "number": [
        "#m3-set-size-num",
        "99"
       ]
      }
     ],
     "expect": [
      "#m3-set-size-num.ex-invalid",
      ".ex-dash.ex-stale"
     ]
    }
